# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
BOT_USERNAME=your_bot_username_here

# Owner and Admin IDs (comma-separated)
OWNER_IDS=123456789,987654321
ADMIN_IDS=123456789

# Channel Configuration (multiple channels separated by semicolon)
# Format: URL1;URL2;URL3
CHANNEL_URLS=https://t.me/channel1;https://t.me/channel2
# Format: ID1;ID2;ID3
CHANNEL_IDS=-1001234567890;-1009876543210

# Subscription GIF ID
SUBSCRIPTION_GIF_ID=your_gif_file_id_here

# Maintenance mode GIF (shown when bot is in maintenance)
MAINTENANCE_GIF_ID=your_maintenance_gif_file_id_here

# Maintenance mode (true/false) - set to true to restrict access to owners only
MAINTENANCE_MODE=false

# Database
DATABASE_NAME=tasks_bot.db

# Bot Settings
MIN_WITHDRAW_AMOUNT=0.2
TASKS_PER_PAGE=5
TON_PER_24_HOURS=0.00833
MINER_SESSION_HOURS=12
REFERRAL_REWARD=0.04
